@model System.Data.DataTable
@{ Layout = null; }
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>StockManager - Stock</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/styles.css" /></head>
<body><div class="app-layout">
@await Html.PartialAsync("_Sidebar")
<div class="main-content">@await Html.PartialAsync("_Topbar", "Stock")<main class="page-content"><section class="page-shell page-shell-entity">

<section class="stats-grid">
  <article class="stat-card"><p>Stock total</p><strong>@(ViewBag.TotalUnites??0)</strong><small>Unités</small></article>
  <article class="stat-card"><p>Références</p><strong>@(ViewBag.TotalStock??0)</strong><small>Articles</small></article>
  <article class="stat-card"><p>Alertes stock faible</p><strong>@(ViewBag.AlertesStock??0)</strong><small>Alertes</small></article>
</section>

<section class="entity-grid"><div class="entity-left">
<section class="filter-bar">
  <label class="search-input"><svg viewBox="0 0 24 24"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z"/></svg><input type="text" id="searchInput" placeholder="Rechercher produit ou localité..." oninput="filterTable()" /></label>
  <label><span>Statut stock</span>
    <select id="filterStatus" onchange="filterByStatus()">
      <option value="">Tous</option><option value="ok">En stock</option><option value="low">Faible (&lt;20)</option><option value="crit">Critique (&lt;5)</option>
    </select>
  </label>
  <button class="action-button secondary" onclick="resetFilters()"><svg viewBox="0 0 24 24"><path d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4"/></svg><span>Réinitialiser</span></button>
</section>
<section class="card"><div class="table-wrapper"><table class="data-table" id="mainTable">
  <thead><tr><th>ID Stock</th><th>Produit</th><th>Catégorie</th><th>Qté Stock</th><th>Localité</th><th>Statut</th></tr></thead>
  <tbody>
    @if(Model!=null){int i=0;foreach(System.Data.DataRow row in Model.Rows){
    int qte = row["qte_stock"]==DBNull.Value?0:Convert.ToInt32(row["qte_stock"]);
    string badge = qte<5?"is-danger":qte<20?"is-warning":"is-success";
    string statut = qte<5?"Critique":qte<20?"Faible":"En stock";
    string statusKey = qte<5?"crit":qte<20?"low":"ok";
    <tr data-index="@i" data-status="@statusKey" class="@(i==0?"selected":"")" onclick="selectRow(this,@i)">
      <td>@row["stock_id"]</td><td>@row["label"]</td><td>@row["nom_categorie"]</td><td>@qte</td><td>@row["localite"]</td>
      <td><span class="status-badge @badge">@statut</span></td>
    </tr>
    i++;}}
  </tbody>
</table></div><div class="pagination-row"><p id="paginationInfo"></p></div></section>
</div>
<aside class="detail-panel"><h3>Détails stock</h3><ul id="detailList"></ul></aside>
</section>
</section></main></div></div>
<div class="toast-wrap" id="toastWrap"></div>

<script>
const ROWS=@Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model?.Rows.Cast<System.Data.DataRow>() ?? System.Linq.Enumerable.Empty<System.Data.DataRow>()).Select(r=>new{
  sid=r["stock_id"],label=r["label"]?.ToString(),cat=r["nom_categorie"]?.ToString(),
  qte=r["qte_stock"]==DBNull.Value?0:Convert.ToInt32(r["qte_stock"]),loc=r["localite"]?.ToString()
}).ToList()));
let selectedIndex=0;
function selectRow(el,i){document.querySelectorAll('#mainTable tbody tr').forEach(r=>r.classList.remove('selected'));el.classList.add('selected');selectedIndex=i;updateDetail(ROWS[i]);}
function updateDetail(r){if(!r)return;const statut=r.qte<5?'Critique':r.qte<20?'Faible':'En stock';document.getElementById('detailList').innerHTML=`<li><span>ID Stock</span><strong>${r.sid}</strong></li><li><span>Produit</span><strong>${r.label||'-'}</strong></li><li><span>Catégorie</span><strong>${r.cat||'-'}</strong></li><li><span>Quantité</span><strong>${r.qte}</strong></li><li><span>Localité</span><strong>${r.loc||'-'}</strong></li><li><span>Statut</span><strong>${statut}</strong></li>`;}
function filterTable(reset){if(reset)document.getElementById('searchInput').value='';const q=document.getElementById('searchInput').value.toLowerCase();let n=0;document.querySelectorAll('#mainTable tbody tr').forEach(tr=>{const ok=tr.textContent.toLowerCase().includes(q);tr.style.display=ok?'':'none';if(ok)n++;});document.getElementById('paginationInfo').textContent=`${n} résultat(s)`;}
function filterByStatus(){const s=document.getElementById('filterStatus').value;let n=0;document.querySelectorAll('#mainTable tbody tr').forEach(tr=>{const ok=!s||tr.dataset.status===s;tr.style.display=ok?'':'none';if(ok)n++;});document.getElementById('paginationInfo').textContent=`${n} résultat(s)`;}
function resetFilters(){document.getElementById('searchInput').value='';document.getElementById('filterStatus').value='';filterTable();}
if(ROWS.length>0){updateDetail(ROWS[0]);document.getElementById('paginationInfo').textContent=`${ROWS.length} article(s)`;}
</script>
</body></html>



