    </section></div><aside class="detail-panel"><h3>Détails stock</h3><ul><li><span>ID Stock</span><strong>STK-001</strong></li><li><span>Produit</span><strong>Chaise de bureau Ergonomique</strong></li><li><span>Catégorie</span><strong>Mobilier</strong></li><li><span>Quantité</span><strong>120</strong></li><li><span>Localité</span><strong>Entrepôt Central</strong></li><li><span>Origine</span><strong>France</strong></li><li><span>Statut</span><strong>En stock</strong></li><li><span>Dernière MAJ</span><strong>18/05/2026 10:32</strong></li></ul><button class="action-button primary full"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11zM14.8 6.2l3.8 3.8" /></svg><span>Voir le stock</span></button></aside></section></section></main></div></div>
    
  
<script>
  (function() {
    const PAGE_ROWS = [{"id": "STK-001", "qte_stock": 120, "produit": "Chaise de bureau Ergonomique", "categorie": "Mobilier", "localite": "Entrep\u00f4t Central", "origine": "France", "statut": "En stock", "updated_at": "18/05/2026 10:32"}, {"id": "STK-002", "qte_stock": 35, "produit": "Bureau Direction 160x80", "categorie": "Tables", "localite": "D\u00e9p\u00f4t Nord", "origine": "Maroc", "statut": "Faible", "updated_at": "18/05/2026 09:12"}, {"id": "STK-003", "qte_stock": 7, "produit": "\u00c9tag\u00e8re m\u00e9tallique 5 niveaux", "categorie": "Rangement", "localite": "D\u00e9p\u00f4t Sud", "origine": "Allemagne", "statut": "Critique", "updated_at": "17/05/2026 18:08"}, {"id": "STK-004", "qte_stock": 9, "produit": "Biblioth\u00e8que \u00e9tag\u00e8re", "categorie": "Rangement", "localite": "Showroom Rabat", "origine": "Italie", "statut": "Critique", "updated_at": "17/05/2026 16:44"}, {"id": "STK-005", "qte_stock": 18, "produit": "Canap\u00e9 3 places tissu", "categorie": "Canap\u00e9s", "localite": "Showroom Casablanca", "origine": "Maroc", "statut": "Faible", "updated_at": "17/05/2026 14:27"}];
    const DETAIL_FIELDS = [{"label": "ID Stock", "key": "id"}, {"label": "Produit", "key": "produit"}, {"label": "Cat\u00e9gorie", "key": "categorie"}, {"label": "Quantit\u00e9", "key": "qte_stock"}, {"label": "Localit\u00e9", "key": "localite"}, {"label": "Origine", "key": "origine"}, {"label": "Statut", "key": "statut"}, {"label": "Derni\u00e8re MAJ", "key": "updated_at"}];

    const rows = document.querySelectorAll("[data-select-row]");
    const detailPanel = document.querySelector(".detail-panel");

    function updateDetail(index) {
      const record = PAGE_ROWS[index];
      if (!record) return;
      
      rows.forEach(r => r.classList.remove("selected"));
      rows[index].classList.add("selected");

      const list = detailPanel.querySelector("ul");
      list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
      
      const descDiv = detailPanel.querySelector(".detail-description p");
      if (descDiv) {
        descDiv.textContent = record.description || record.remarque || "";
      }
    }

    rows.forEach((row, i) => {
      row.addEventListener("click", () => updateDetail(i));
    });
  })();
</script>

