6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4" /></svg><span>Réinitialiser</span></button></section><section class="card"><div class="table-wrapper"><table class="data-table"><thead><tr><th>ID Stock</th><th>Produit</th><th>Catégorie</th><th>Quantité qte_stock</th><th>Localité</th><th>Origine</th><th>Statut</th><th>Dernière mise à jour</th><th>Actions</th></tr></thead><tbody><tr data-select-row data-page="stock" data-index="0" data-row-id="STK-001" class="selected"><td>STK-001</td><td>Chaise de bureau Ergonomique</td><td>Mobilier</td><td>120</td><td>Entrepôt Central</td><td>France</td><td><span class="status-badge is-success">En stock</span></td><td>18/05/2026 10:32</td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="stock" data-index="1" data-row-id="STK-002" class=""><td>STK-002</td><td>Bureau Direction 160x80</td><td>Tables</td><td>35</td><td>Dépôt Nord</td><td>Maroc</td><td><span class="status-badge is-warning">Faible</span></td><td>18/05/2026 09:12</td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="stock" data-index="2" data-row-id="STK-003" class=""><td>STK-003</td><td>Étagère métallique 5 niveaux</td><td>Rangement</td><td>7</td><td>Dépôt Sud</td><td>Allemagne</td><td><span class="status-badge is-danger">Critique</span></td><td>17/05/2026 18:08</td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="stock" data-index="3" data-row-id="STK-004" class=""><td>STK-004</td><td>Bibliothèque étagère</td><td>Rangement</td><td>9</td><td>Showroom Rabat</td><td>Italie</td><td><span class="status-badge is-danger">Critique</span></td><td>17/05/2026 16:44</td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="stock" data-index="4" data-row-id="STK-005" class=""><td>STK-005</td><td>Canapé 3 places tissu</td><td>Canapés</td><td>18</td><td>Showroom Casablanca</td><td>Maroc</td><td><span class="status-badge is-warning">Faible</span></td><td>17/05/2026 14:27</td><td><button class="row-action">⋮</button></td></tr></tbody></table></div>
