@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StockManager - Reports</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
    <div class="app-layout">
        @await Html.PartialAsync("_Sidebar")
        <div class="main-content">
            @await Html.PartialAsync("_Topbar", "Reports")
            <main class="page-content">
                <section class="card">
                    <div class="card-head"><h3>Rapports et Statistiques</h3></div>
                    <p style="padding: 20px;">Contenu des rapports à venir...</p>
                </section>
            </main>
        </div>
    </div>
</body>
</html>
