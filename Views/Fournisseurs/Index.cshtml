d><td>+212 5 24 76 82 11</td><td>pro@boiscreations.ma</td><td>Av. Mohammed V</td><td>Fès</td><td>Qualité premium</td><td><span class="status-badge is-success">Actif</span></td><td><button class="row-action">⋮</button></td></tr></tbody></table></div>
                        <div class="pagination-row">
                            <p>Affichage de 1 à 5 sur 5 fournisseurs</p>
                            <div class="pagination-controls">
                                <button>«</button><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>4</button><button>5</button><span>…</span><button>16</button><button>›</button><button>»</button>
                            </div>
                        </div>
                    </section>
                </div><aside class="detail-panel"><h3>Détails fournisseur</h3><ul><li><span>ID</span><strong>FRN-001</strong></li><li><span>Raison sociale</span><strong>Mobilier Design SARL</strong></li><li><span>Contact</span><strong>+212 6 12 34 56 78</strong></li><li><span>Fax</span><strong>+212 5 22 11 22 33</strong></li><li><span>Email</span><strong>contact@mobilierdesign.ma</strong></li><li><span>Adresse</span><strong>12 Rue Atlas</strong></li><li><span>Ville</span><strong>Casablanca</strong></li><li><span>Remarque</span><strong>Livraisons hebdomadaires</strong></li><li><span>Produits fournis</span><strong>34</strong></li><li><span>Dernière livraison</span><strong>16/05/2026</strong></li></ul><button class="action-button primary full"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11zM14.8 6.2l3.8 3.8" /></svg><span>Modifier le fournisseur</span></button></aside>
            </section>
        </section>
