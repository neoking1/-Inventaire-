<script>
  (function() {
    const PAGE_ROWS = [{"fournisseur_id": "FRN-001", "raison_social": "Mobilier Design SARL", "contact": "+212 6 12 34 56 78", "fax": "+212 5 22 11 22 33", "email": "contact@mobilierdesign.ma", "adress": "12 Rue Atlas", "ville": "Casablanca", "remarque": "Livraisons hebdomadaires", "statut": "Actif", "produits_fournis": 34, "derniere_livraison": "16/05/2026"}, {"fournisseur_id": "FRN-002", "raison_social": "Alliances Bois", "contact": "+212 6 67 45 90 12", "fax": "+212 5 37 88 44 10", "email": "sales@alliancesbois.ma", "adress": "Zone Industrielle 4", "ville": "Rabat", "remarque": "Paiement 30 jours", "statut": "Actif", "produits_fournis": 21, "derniere_livraison": "14/05/2026"}, {"fournisseur_id": "FRN-003", "raison_social": "Office Plus", "contact": "+212 6 01 98 77 54", "fax": "+212 5 24 33 12 09", "email": "support@officeplus.ma", "adress": "Bd Hassan II", "ville": "Marrakech", "remarque": "Stock rapide", "statut": "Actif", "produits_fournis": 18, "derniere_livraison": "12/05/2026"}, {"fournisseur_id": "FRN-004", "raison_social": "Sud Bureau", "contact": "+212 6 87 20 14 55", "fax": "+212 5 28 98 11 42", "email": "contact@sudbureau.ma", "adress": "Parc Logistique A2", "ville": "Agadir", "remarque": "D\u00e9lais variables", "statut": "Inactif", "produits_fournis": 9, "derniere_livraison": "03/05/2026"}, {"fournisseur_id": "FRN-005", "raison_social": "Bois & Cr\u00e9ations", "contact": "+212 6 55 22 33 44", "fax": "+212 5 24 76 82 11", "email": "pro@boiscreations.ma", "adress": "Av. Mohammed V", "ville": "F\u00e8s", "remarque": "Qualit\u00e9 premium", "statut": "Actif", "produits_fournis": 27, "derniere_livraison": "17/05/2026"}];
    const DETAIL_FIELDS = [{"label": "ID", "key": "fournisseur_id"}, {"label": "Raison sociale", "key": "raison_social"}, {"label": "Contact", "key": "contact"}, {"label": "Fax", "key": "fax"}, {"label": "Email", "key": "email"}, {"label": "Adresse", "key": "adress"}, {"label": "Ville", "key": "ville"}, {"label": "Remarque", "key": "remarque"}, {"label": "Produits fournis", "key": "produits_fournis"}, {"label": "Derni\u00e8re livraison", "key": "derniere_livraison"}];

    const rows = document.querySelectorAll("[data-select-row]");
    const detailPanel = document.querySelector(".detail-panel");

    function updateDetail(index) {
      const record = PAGE_ROWS[index];
      if (!record) return;
      
      rows.forEach(r => r.classList.remove("selected"));
      rows[index].classList.add("selected");

      const list = detailPanel.querySelector("ul");
      list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
      
      const descDiv = detailPanel.querySelector(".detail-description p");
      if (descDiv) {
        descDiv.textContent = record.description || record.remarque || "";
      }
    }

    rows.forEach((row, i) => {
      row.addEventListener("click", () => updateDetail(i));
    });
  })();
</script>

