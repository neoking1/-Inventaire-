@{ Layout = null; }
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>StockManager - Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/styles.css" /></head>
<body><div class="app-layout">
@await Html.PartialAsync("_Sidebar")
<div class="main-content dashboard-main">@await Html.PartialAsync("_Topbar", "Dashboard")<main class="page-content"><section class="page-shell page-shell-dashboard">

<section class="stats-grid six">
  <article class="stat-card"><p>Produits</p><strong>@(ViewBag.TotalProduits??0)</strong><small>Références</small></article>
  <article class="stat-card"><p>Catégories</p><strong>@(ViewBag.TotalCategories??0)</strong><small>Groupes</small></article>
  <article class="stat-card"><p>Fournisseurs</p><strong>@(ViewBag.TotalFournisseurs??0)</strong><small>Partenaires</small></article>
  <article class="stat-card"><p>Stock total</p><strong>@(ViewBag.TotalStock??0)</strong><small>Unités</small></article>
  <article class="stat-card"><p>Entrées</p><strong>@(ViewBag.TotalEntrees??0)</strong><small>Mouvements</small></article>
  <article class="stat-card"><p>Sorties</p><strong>@(ViewBag.TotalSorties??0)</strong><small>Mouvements</small></article>
</section>

<div class="dashboard-two-cols">
  <section class="card">
    <h3 style="padding:1rem 1.25rem .5rem;font-size:1rem;font-weight:700">Dernières entrées</h3>
    <div class="table-wrapper">
      <table class="data-table">
        <thead><tr><th>ID</th><th>Date</th><th>Produit</th><th>Qté</th><th>Fournisseur</th></tr></thead>
        <tbody>
          @if(ViewBag.RecentEntrees!=null){
            foreach(System.Data.DataRow row in ((System.Data.DataTable)ViewBag.RecentEntrees).Rows){
              string d=row["date_entree"]==DBNull.Value?"":((DateTime)row["date_entree"]).ToString("dd/MM/yy");
              <tr><td>@row["id"]</td><td>@d</td><td>@row["produit"]</td><td>@row["qte_entree"]</td><td>@row["fournisseur"]</td></tr>
            }
          } else {
            <tr><td colspan="5" style="text-align:center;color:var(--text-muted)">Aucune donnée</td></tr>
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h3 style="padding:1rem 1.25rem .5rem;font-size:1rem;font-weight:700">Dernières sorties</h3>
    <div class="table-wrapper">
      <table class="data-table">
        <thead><tr><th>ID</th><th>Date</th><th>Produit</th><th>Qté</th><th>Personne</th></tr></thead>
        <tbody>
          @if(ViewBag.RecentSorties!=null){
            foreach(System.Data.DataRow row in ((System.Data.DataTable)ViewBag.RecentSorties).Rows){
              string d=row["date_sortie"]==DBNull.Value?"":((DateTime)row["date_sortie"]).ToString("dd/MM/yy");
              <tr><td>@row["id"]</td><td>@d</td><td>@row["produit"]</td><td>@row["qte_sortie"]</td><td>@row["personne"]</td></tr>
            }
          } else {
            <tr><td colspan="5" style="text-align:center;color:var(--text-muted)">Aucune donnée</td></tr>
          }
        </tbody>
      </table>
    </div>
  </section>
</div>

@if(ViewBag.LowStock!=null && ((System.Data.DataTable)ViewBag.LowStock).Rows.Count>0){
<section class="card" style="margin-top:1.5rem">
  <h3 style="padding:1rem 1.25rem .5rem;font-size:1rem;font-weight:700;color:#ef4444">⚠ Alertes stock faible</h3>
  <div class="table-wrapper">
    <table class="data-table">
      <thead><tr><th>ID Stock</th><th>Produit</th><th>Quantité</th><th>Statut</th></tr></thead>
      <tbody>
        @foreach(System.Data.DataRow row in ((System.Data.DataTable)ViewBag.LowStock).Rows){
          int q=row["qte_stock"]==DBNull.Value?0:Convert.ToInt32(row["qte_stock"]);
          string badge=q<5?"is-danger":"is-warning";
          string statut=q<5?"Critique":"Faible";
          <tr><td>@row["id"]</td><td>@row["label"]</td><td>@q</td><td><span class="status-badge @badge">@statut</span></td></tr>
        }
      </tbody>
    </table>
  </div>
</section>
}

</section></main></div></div>
</body></html>

