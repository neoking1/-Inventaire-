@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StockManager - Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/styles.css" />
  </head>
  <body>
    <div class="app-layout"><aside class="sidebar"><div class="sidebar-brand"><div class="brand-logo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5L12 3l9 4.5-9 4.5zM3 7.5V16.5L12 21l9-4.5V7.5" /></svg></div><div><h2>StockManager</h2><p>Gestion de Stock</p></div></div><nav class="sidebar-nav"><a class="sidebar-link is-active " href="/Home/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5L12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z" /></svg><span>Dashboard</span></a><a class="sidebar-link  " href="/Produit/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5L12 3l9 4.5-9 4.5zM3 7.5V16.5L12 21l9-4.5V7.5" /></svg><span>Produits</span></a><a class="sidebar-link  " href="/Entrees/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v13M7 8l5-5 5 5M5 21h14" /></svg><span>Entrées</span></a><a class="sidebar-link  " href="/Sorties/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V8M7 13l5 5 5-5M5 3h14" /></svg><span>Sorties</span></a><a class="sidebar-link  " href="/Stock/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8l8-4 8 4-8 4zM4 12l8 4 8-4M4 16l8 4 8-4" /></svg><span>Stock</span></a><a class="sidebar-link  " href="/Categories/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12l9-9h8v8l-9 9H3zM16 8h.01" /></svg><span>Catégories</span></a><a class="sidebar-link  " href="/Fournisseurs/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h12v9H3zM15 9h4l2 2v4h-6M7 18a2 2 0 1 0 0 .01M18 18a2 2 0 1 0 0 .01" /></svg><span>Fournisseurs</span></a><a class="sidebar-link  " href="/Origin/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 0v18M3 12h18" /></svg><span>Origine</span></a><a class="sidebar-link  " href="/Localite/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.3 7-11a7 7 0 1 0-14 0c0 5.7 7 11 7 11zM12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" /></svg><span>Localité</span></a><a class="sidebar-link  " href="/Users/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM8 13a3 3 0 1 0-3-3 3 3 0 0 0 3 3zM3 20a5 5 0 0 1 10 0M13 20a6 6 0 0 1 8 0" /></svg><span>Users</span></a><a class="sidebar-link  " href="/personne/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4.5 4.5 0 1 0-4.5-4.5A4.5 4.5 0 0 0 12 12zM4 21a8 8 0 0 1 16 0" /></svg><span>Personnes</span></a><a class="sidebar-link  is-logout" href="/Auth/Logout"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 17l5-5-5-5M20 12H9M12 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h7" /></svg><span>Déconnexion</span></a></nav></aside><div class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-button" type="button" aria-label="Menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
        <div class="topbar-title-group">
          <h1>Dashboard</h1>
          <p>Vue globale de votre gestion de stock</p>
        </div>
      </div>
      <div class="topbar-right">
        <label class="search-input"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z" /></svg><input type="text" placeholder="Rechercher un produit, catégorie, fournisseur..." /></label>
        <button class="notif-button" type="button" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a5 5 0 0 0-5 5v3.8L5 15v1h14v-1l-2-3.2V8a5 5 0 0 0-5-5zM10 19a2 2 0 0 0 4 0" /></svg><span>3</span></button>
        <button class="profile-chip" type="button">
          <span class="avatar">AD</span>
          <span class="profile-text"><strong>Admin</strong><small>Administrateur</small></span>
        </button>
      </div>
    </header>
    <main class="page-content">
    <section class="dashboard-grid">
      <section class="stats-grid six">
        <article class="stat-card"><p>Total Produits</p><strong>156</strong><small>Catalogue global</small></article>
        <article class="stat-card"><p>Stock Total</p><strong>8 756</strong><small>Unités disponibles</small></article>
        <article class="stat-card"><p>Entrées du mois</p><strong>274</strong><small>Mouvements entrants</small></article>
        <article class="stat-card"><p>Sorties du mois</p><strong>198</strong><small>Mouvements sortants</small></article>
        <article class="stat-card"><p>Fournisseurs</p><strong>5</strong><small>Partenaires actifs</small></article>
        <article class="stat-card"><p>Utilisateurs</p><strong>6</strong><small>Comptes actifs</small></article>
      </section>
      <section class="dashboard-two-cols">
        <article class="card chart-card">
          <div class="card-head"><h3>Mouvement de stock</h3><span>30 derniers jours</span></div>
          <div class="chart-placeholder"><div class="line"></div><div class="line second"></div></div>    
        </article>
        <article class="card">
          <div class="card-head"><h3>Alertes stock faible</h3><a href="/Stock/Index">Voir tout</a></div>    
          <ul class="compact-list"><li><span>Bureau Direction 160x80</span><span class="status-badge is-warning">Faible</span></li><li><span>Étagère métallique 5 niveaux</span><span class="status-badge is-danger">Critique</span></li><li><span>Canapé 3 places tissu</span><span class="status-badge is-warning">Faible</span></li><li><span>Bibliothèque étagère</span><span class="status-badge is-danger">Critique</span></li></ul>
        </article>
      </section>
      <section class="dashboard-two-cols">
        <article class="card">
          <div class="card-head"><h3>Produits récents</h3><a href="/Produit/Index">Voir tout</a></div>    
          <div class="table-wrapper"><table class="data-table"><thead><tr><th>ID</th><th>Produit</th><th>Catégorie</th><th>Stock</th><th>Fournisseur</th><th>Origine</th><th>Localité</th><th>Prix</th><th>Statut</th></tr></thead><tbody><tr data-select-row data-page="dashboard" data-index="0" data-row-id="PRD-001" class=""><td>PRD-001</td><td>Chaise de bureau Ergonomique</td><td>Mobilier</td><td>120</td><td>Mobilier Design SARL</td><td>France</td><td>Entrepôt Central</td><td>85,00 €</td><td><span class="status-badge is-success">En stock</span></td></tr><tr data-select-row data-page="dashboard" data-index="1" data-row-id="PRD-002" class=""><td>PRD-002</td><td>Bureau Direction 160x80</td><td>Tables</td><td>35</td><td>Alliances Bois</td><td>Maroc</td><td>Dépôt Nord</td><td>250,00 €</td><td><span class="status-badge is-warning">Faible</span></td></tr><tr data-select-row data-page="dashboard" data-index="2" data-row-id="PRD-003" class=""><td>PRD-003</td><td>Étagère métallique 5 niveaux</td><td>Rangement</td><td>7</td><td>Office Plus</td><td>Allemagne</td><td>Dépôt Sud</td><td>160,00 €</td><td><span class="status-badge is-danger">Critique</span></td></tr><tr data-select-row data-page="dashboard" data-index="3" data-row-id="PRD-004" class=""><td>PRD-004</td><td>Table basse bois massif</td><td>Tables</td><td>42</td><td>Bois &amp; Créations</td><td>Italie</td><td>Showroom Rabat</td><td>129,00 €</td><td><span class="status-badge is-success">En stock</span></td></tr><tr data-select-row data-page="dashboard" data-index="4" data-row-id="PRD-005" class=""><td>PRD-005</td><td>Canapé 3 places tissu</td><td>Canapés</td><td>18</td><td>Sud Bureau</td><td>Maroc</td><td>Showroom Casablanca</td><td>540,00 €</td><td><span class="status-badge is-warning">Faible</span></td></tr></tbody></table></div>
        </article>
        <article class="card">
          <div class="card-head"><h3>Activité récente</h3><a href="/Users/Index">Journal</a></div>        
          <ul class="activity-list"><li>Entrée ENT-001 validée par Claire Martin</li><li>Sortie SOR-001 imprimée par Jean Dupont</li><li>Nouveau fournisseur FRN-005 ajouté</li><li>Mise à jour stock STK-003 effectuée</li><li>Utilisateur operateur1 connecté</li></ul>
        </article>
      </section>
    </section>
    </main></div></div>
    
  </body>
</html>

