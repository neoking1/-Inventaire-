                        <div class="pagination-row">
                            <p>Affichage de 1 à 4 sur 482 entrées</p>
                            <div class="pagination-controls">
                                <button>«</button><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>4</button><button>5</button><span>…</span><button>16</button><button>›</button><button>»</button>
                            </div>
                        </div>
                    </section>
                </div><aside class="detail-panel"><h3>Détails entrée</h3><ul><li><span>ID Entrée</span><strong>ENT-001</strong></li><li><span>Date d&#039;entrée</span><strong>18/05/2026</strong></li><li><span>Quantité entrée</span><strong>40</strong></li><li><span>Produit</span><strong>Chaise de bureau Ergonomique</strong></li><li><span>Stock</span><strong>STK-001</strong></li><li><span>Fournisseur</span><strong>Mobilier Design SARL</strong></li><li><span>Origine</span><strong>France</strong></li><li><span>Statut</span><strong>Validée</strong></li></ul><button class="action-button primary full"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11zM14.8 6.2l3.8 3.8" /></svg><span>Modifier l&#039;entrée</span></button></aside>
            </section>
        </section>
    </main>
</div>
</div>

<script>
        (function() {
          const PAGE_ROWS = [{"id": "ENT-001", "date_entree": "18/05/2026", "qte_entree": 40, "produit_id": "PRD-001", "produit": "Chaise de bureau Ergonomique", "stock_id": "STK-001", "fournisseur_id": "FRN-001", "fournisseur": "Mobilier Design SARL", "origin_id": "ORG-002", "origine": "France", "statut": "Valid\u00e9e"}, {"id": "ENT-002", "date_entree": "17/05/2026", "qte_entree": 22, "produit_id": "PRD-002", "produit": "Bureau Direction 160x80", "stock_id": "STK-002", "fournisseur_id": "FRN-002", "fournisseur": "Alliances Bois", "origin_id": "ORG-001", "origine": "Maroc", "statut": "Valid\u00e9e"}, {"id": "ENT-003", "date_entree": "15/05/2026", "qte_entree": 30, "produit_id": "PRD-004", "produit": "Table basse bois massif", "stock_id": "STK-003", "fournisseur_id": "FRN-005", "fournisseur": "Bois & Cr\u00e9ations", "origin_id": "ORG-004", "origine": "Italie", "statut": "Valid\u00e9e"}, {"id": "ENT-004", "date_entree": "14/05/2026", "qte_entree": 10, "produit_id": "PRD-007", "produit": "Biblioth\u00e8que \u00e9tag\u00e8re", "stock_id": "STK-004", "fournisseur_id": "FRN-003", "fournisseur": "Office Plus", "origin_id": "ORG-004", "origine": "Italie", "statut": "En attente"}];
          const DETAIL_FIELDS = [{"label": "ID Entr\u00e9e", "key": "id"}, {"label": "Date d'entr\u00e9e", "key": "date_entree"}, {"label": "Quantit\u00e9 entr\u00e9e", "key": "qte_entree"}, {"label": "Produit", "key": "produit"}, {"label": "Stock", "key": "stock_id"}, {"label": "Fournisseur", "key": "fournisseur"}, {"label": "Origine", "key": "origine"}, {"label": "Statut", "key": "statut"}];

          const rows = document.querySelectorAll("[data-select-row]");
          const detailPanel = document.querySelector(".detail-panel");

          function updateDetail(index) {
            const record = PAGE_ROWS[index];
            if (!record) return;
            rows.forEach(r => r.classList.remove("selected"));
            rows[index].classList.add("selected");
            const list = detailPanel.querySelector("ul");
            list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
            const descDiv = detailPanel.querySelector(".detail-description p");
            if (descDiv) {
              descDiv.textContent = record.description || record.remarque || "";
            }
          }

          rows.forEach((row, i) => {
            row.addEventListener("click", () => updateDetail(i));
          });
        })();
</script>

</body>
</html>
