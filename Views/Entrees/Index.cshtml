                        <section class="filter-bar"><label class="search-input"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z" /></svg><input type="text" placeholder="Rechercher une entrée..." /></label><label><span>Date range</span><select><option>30 derniers jours</option><option>7 derniers jours</option><option>Ce mois</option></select></label><label><span>Fournisseur</span><select><option>Tous</option><option>Mobilier Design SARL</option><option>Alliances Bois</option><option>Office Plus</option><option>Sud Bureau</option><option>Bois &amp; Créations</option></select></label><label><span>Stock</span><select><option>Tous</option><option>STK-001</option><option>STK-002</option><option>STK-003</option><option>STK-004</option><option>STK-005</option></select></label><label><span>Origine</span><select><option>Toutes</option><option>Maroc</option><option>France</option><option>Allemagne</option><option>Italie</option></select></label><label><span>Produit</span><select><option>Tous</option><option>PRD-001</option><option>PRD-002</option><option>PRD-003</option><option>PRD-004</option><option>PRD-005</option></select></label><label><span>Statut</span><select><option>Tous</option><option>Validée</option><option>En attente</option></select></label><button class="action-button secondary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4" /></svg><span>Réinitialiser</span></button></section><section class="card">
