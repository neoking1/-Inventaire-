@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StockManager - Catégories</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
    <div class="app-layout">
        @await Html.PartialAsync("_Sidebar")
        <div class="main-content">
            @await Html.PartialAsync("_Topbar", "Catalogues")
            <main class="page-content">
                <section class="page-shell">
                    <div class="page-actions"><button class="action-button primary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg><span>Ajouter catégorie</span></button></div><section class="stats-grid"><article class="stat-card"><p>Total Catégories</p><strong>12</strong><small>Références</small></article><article class="stat-card"><p>Produits associés</p><strong>156</strong><small>Catalogue</small></article><article class="stat-card"><p>Catégories actives</p><strong>10</strong><small>Actives</small></article><article class="stat-card"><p>Ajouts récents</p><strong>2</strong><small>Ce mois</small></article></section><section class="entity-grid">
                    <div class="entity-left">
                        <section class="filter-bar"><label class="search-input"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z" /></svg><input type="text" placeholder="Rechercher une catégorie..." /></label><label><span>Statut</span><select><option>Tous</option><option>Actif</option><option>Inactif</option></select></label><button class="action-button secondary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4" /></svg><span>Réinitialiser</span></button></section><section class="card">
                        <div class="table-wrapper"><table class="data-table"><thead><tr><th>ID</th><th>Nom catégorie</th><th>Produits associés</th><th>Statut</th><th>Actions</th></tr></thead><tbody><tr data-select-row data-page="categories" data-index="0" data-row-id="CAT-001" class="selected"><td>CAT-001</td><td>Mobilier</td><td>28</td><td><span class="status-badge is-success">Actif</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="categories" data-index="1" data-row-id="CAT-002" class=""><td>CAT-002</td><td>Tables</td><td>22</td><td><span class="status-badge is-success">Actif</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="categories" data-index="2" data-row-id="CAT-003" class=""><td>CAT-003</td><td>Rangement</td><td>34</td><td><span class="status-badge is-success">Actif</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="categories" data-index="3" data-row-id="CAT-004" class=""><td>CAT-004</td><td>Éclairage</td><td>16</td><td><span class="status-badge is-success">Actif</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="categories" data-index="4" data-row-id="CAT-005" class=""><td>CAT-005</td><td>Canapés</td><td>12</td><td><span class="status-badge is-success">Actif</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="categories" data-index="5" data-row-id="CAT-006" class=""><td>CAT-006</td><td>Accessoires</td><td>44</td><td><span class="status-badge is-success">Inactif</span></td><td><button class="row-action">⋮</button></td></tr></tbody></table></div>
                        <div class="pagination-row">
                            <p>Affichage de 1 à 6 sur 12 catégories</p>
                            <div class="pagination-controls">
                                <button>«</button><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>4</button><button>5</button><span>…</span><button>16</button><button>›</button><button>»</button>
                            </div>
                        </div>
                    </section>
                </div><aside class="detail-panel"><h3>Détails catégorie</h3><ul><li><span>ID</span><strong>CAT-001</strong></li><li><span>Nom</span><strong>Mobilier</strong></li><li><span>Statut</span><strong>Actif</strong></li><li><span>Produits associés</span><strong>28</strong></li></ul><div class="detail-description"><h4>Description</h4><p>Catégorie liée au catalogue principal avec suivi d&#039;activité.</p></div><button class="action-button primary full"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11zM14.8 6.2l3.8 3.8" /></svg><span>Voir tous les produits</span></button></aside>
            </section>
        </section>
    </main>
</div>
</div>

<script>
        (function() {
          const PAGE_ROWS = [{"id": "CAT-001", "nom_categorie": "Mobilier", "produits": 28, "statut": "Actif"}, {"id": "CAT-002", "nom_categorie": "Tables", "produits": 22, "statut": "Actif"}, {"id": "CAT-003", "nom_categorie": "Rangement", "produits": 34, "statut": "Actif"}, {"id": "CAT-004", "nom_categorie": "\u00c9clairage", "produits": 16, "statut": "Actif"}, {"id": "CAT-005", "nom_categorie": "Canap\u00e9s", "produits": 12, "statut": "Actif"}, {"id": "CAT-006", "nom_categorie": "Accessoires", "produits": 44, "statut": "Inactif"}];
          const DETAIL_FIELDS = [{"label": "ID", "key": "id"}, {"label": "Nom", "key": "nom_categorie"}, {"label": "Statut", "key": "statut"}, {"label": "Produits associ\u00e9s", "key": "produits"}];

          const rows = document.querySelectorAll("[data-select-row]");
          const detailPanel = document.querySelector(".detail-panel");

          function updateDetail(index) {
            const record = PAGE_ROWS[index];
            if (!record) return;
            rows.forEach(r => r.classList.remove("selected"));
            rows[index].classList.add("selected");
            const list = detailPanel.querySelector("ul");
            list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
            const descDiv = detailPanel.querySelector(".detail-description p");
            if (descDiv) {
              descDiv.textContent = record.description || record.remarque || "";
            }
          }

          rows.forEach((row, i) => {
            row.addEventListener("click", () => updateDetail(i));
          });
        })();
</script>

</body>
</html>
