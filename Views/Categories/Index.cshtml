@model System.Data.DataTable
@{
    Layout = null;
    int totalCats = ViewBag.TotalCategories ?? 0;
    int totalProd = ViewBag.TotalProduits ?? 0;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StockManager - Catégories</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
<div class="app-layout">
    @await Html.PartialAsync("_Sidebar")
    <div class="main-content">
        @await Html.PartialAsync("_Topbar", "Catalogues")
        <main class="page-content">
          <section class="page-shell page-shell-entity">

            <div class="page-actions">
              @if (ViewBag.CanEdit == true) {
                <button class="action-button primary" onclick="openModal()">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  <span>Ajouter catégorie</span>
                </button>
              }
            </div>

            <section class="stats-grid">
              <article class="stat-card"><p>Total Catégories</p><strong>@totalCats</strong><small>Références</small></article>
              <article class="stat-card"><p>Produits associés</p><strong>@totalProd</strong><small>Catalogue</small></article>
            </section>

            <section class="entity-grid">
              <div class="entity-left">
                <section class="filter-bar">
                  <label class="search-input">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z"/></svg>
                    <input type="text" id="searchInput" placeholder="Rechercher une catégorie..." oninput="filterTable()" />
                  </label>
                  <button class="action-button secondary" onclick="filterTable(true)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4"/></svg>
                    <span>Réinitialiser</span>
                  </button>
                </section>

                <section class="card">
                  <div class="table-wrapper">
                    <table class="data-table has-actions" id="mainTable">
                      <thead><tr><th>ID</th><th>Nom catégorie</th><th>Produits associés</th><th>Actions</th></tr></thead>
                      <tbody>
                        @if (Model != null) {
                          int i = 0;
                          foreach (System.Data.DataRow row in Model.Rows) {
                            <tr data-index="@i" class="@(i==0?"selected":"")" onclick="selectRow(this,@i)">
                              <td>@row["id"]</td>
                              <td>@row["nom_categorie"]</td>
                              <td>@row["nb_produits"]</td>
                              <td>
                                <div class="row-menu-wrap">
                                  <button class="row-action" onclick="toggleMenu(event,this)">⋮</button>
                                  <div class="row-menu">
                                    @if (ViewBag.CanEdit == true) {
                                      <button onclick="openEditModalByIndex(@i)">
                                        <svg viewBox="0 0 24 24"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11z"/></svg>Modifier
                                      </button>
                                      <button class="is-danger" onclick="confirmDelete(@row["id"])">
                                        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>Supprimer
                                      </button>
                                    }
                                  </div>
                                </div>
                              </td>
                            </tr>
                            i++;
                          }
                        }
                      </tbody>
                    </table>
                  </div>
                  <div class="pagination-row"><p id="paginationInfo"></p></div>
                </section>
              </div>

              <aside class="detail-panel">
                <h3>Détails catégorie</h3>
                <ul id="detailList"></ul>
                @if (ViewBag.CanEdit == true) {
                  <button class="action-button primary full" onclick="editSelected()">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11z"/></svg>
                    <span>Modifier</span>
                  </button>
                }
              </aside>
            </section>
          </section>
        </main>
    </div>
</div>

<!-- Modal Add/Edit -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModalIfBg(event)">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="modalTitle">Ajouter une catégorie</h3>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="form-group">
      <label>Nom de la catégorie</label>
      <input type="text" id="f_nom" placeholder="Ex: Mobilier" />
    </div>
    <input type="hidden" id="f_id" />
    <div class="modal-footer">
      <button class="action-button secondary" onclick="closeModal()">Annuler</button>
      <button class="action-button primary" onclick="saveCategorie()">Enregistrer</button>
    </div>
  </div>
</div>

<!-- Confirm Delete -->
<div class="modal-overlay" id="confirmOverlay" onclick="closeModalIfBg(event)">
  <div class="modal-box confirm-dialog">
    <div class="confirm-icon"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></div>
    <h3>Supprimer la catégorie ?</h3>
    <p>Cette action est irréversible.</p>
    <div class="modal-footer">
      <button class="action-button secondary" onclick="closeConfirm()">Annuler</button>
      <button class="action-button primary" style="background:#ef4444" onclick="doDelete()">Supprimer</button>
    </div>
  </div>
</div>
<div class="toast-wrap" id="toastWrap"></div>

<script>
const ROWS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
  (Model?.Rows.Cast<System.Data.DataRow>() ?? System.Linq.Enumerable.Empty<System.Data.DataRow>()).Select(r => new {
    id = r["id"], nom = r["nom_categorie"].ToString(), produits = r["nb_produits"]
  }).ToList()
));
let selectedIndex = 0, deleteId = null;

function selectRow(el, i) {
  document.querySelectorAll('#mainTable tbody tr').forEach(r => r.classList.remove('selected'));
  el.classList.add('selected'); selectedIndex = i; updateDetail(ROWS[i]);
}
function updateDetail(r) {
  if (!r) return;
  document.getElementById('detailList').innerHTML =
    `<li><span>ID</span><strong>${r.id}</strong></li>
     <li><span>Nom catégorie</span><strong>${r.nom}</strong></li>
     <li><span>Produits associés</span><strong>${r.produits}</strong></li>`;
}
function filterTable(reset) {
  if (reset) document.getElementById('searchInput').value = '';
  const q = document.getElementById('searchInput').value.toLowerCase();
  let n = 0;
  document.querySelectorAll('#mainTable tbody tr').forEach(tr => {
    const ok = tr.textContent.toLowerCase().includes(q);
    tr.style.display = ok ? '' : 'none'; if (ok) n++;
  });
  document.getElementById('paginationInfo').textContent = `${n} résultat(s)`;
}
function toggleMenu(e, btn) {
  e.stopPropagation();
  const m = btn.nextElementSibling;
  document.querySelectorAll('.row-menu.is-open').forEach(x => { if (x!==m) x.classList.remove('is-open'); });
  m.classList.toggle('is-open');
}
document.addEventListener('click', () => document.querySelectorAll('.row-menu.is-open').forEach(m => m.classList.remove('is-open')));
function openModal() { document.getElementById('modalTitle').textContent='Ajouter une catégorie'; document.getElementById('f_id').value=''; document.getElementById('f_nom').value=''; document.getElementById('modalOverlay').classList.add('is-open'); }
function openEditModal(id, nom) { document.getElementById('modalTitle').textContent='Modifier la catégorie'; document.getElementById('f_id').value=id; document.getElementById('f_nom').value=nom; document.getElementById('modalOverlay').classList.add('is-open'); }
function openEditModalByIndex(i) { const r = ROWS[i]; if (r) openEditModal(r.id, r.nom); }
function editSelected() { const r=ROWS[selectedIndex]; if(r) openEditModal(r.id,r.nom); }
function closeModal() { document.getElementById('modalOverlay').classList.remove('is-open'); }
function closeConfirm() { document.getElementById('confirmOverlay').classList.remove('is-open'); }
function closeModalIfBg(e) { if(e.target.classList.contains('modal-overlay')) { closeModal(); closeConfirm(); } }
async function saveCategorie() {
  const id=document.getElementById('f_id').value, nom=document.getElementById('f_nom').value.trim();
  if(!nom) { showToast('Le nom est requis.','error'); return; }
  const url=id?'/Categories/Update':'/Categories/Create';
  const body=new URLSearchParams({nomCategorie:nom}); if(id) body.append('id',id);
  const r=await fetch(url,{method:'POST',body}); const d=await r.json();
  if(d.success) { showToast(d.message,'success'); closeModal(); setTimeout(()=>location.reload(),700); }
  else showToast(d.message,'error');
}
function confirmDelete(id) { deleteId=id; document.getElementById('confirmOverlay').classList.add('is-open'); }
async function doDelete() {
  const r=await fetch('/Categories/Delete',{method:'POST',body:new URLSearchParams({id:deleteId})}); const d=await r.json();
  closeConfirm(); if(d.success) { showToast(d.message,'success'); setTimeout(()=>location.reload(),700); } else showToast(d.message,'error');
}
function showToast(msg,type) {
  const t=document.createElement('div'); t.className=`toast ${type}`; t.textContent=msg;
  document.getElementById('toastWrap').appendChild(t); setTimeout(()=>t.remove(),3500);
}
if(ROWS.length>0) { updateDetail(ROWS[0]); document.getElementById('paginationInfo').textContent=`${ROWS.length} catégorie(s)`; }
</script>
</body>
</html>




