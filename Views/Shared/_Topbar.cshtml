@model string
<header class="topbar">
    <div class="topbar-left">
        <button class="menu-button" type="button" aria-label="Menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
        <div class="topbar-title-group">
            <h1>@Model</h1>
            <p>Gestion de stock - Inventaire</p>
        </div>
    </div>
    <div class="topbar-right">
        <label class="search-input"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z" /></svg><input type="text" placeholder="Rechercher..." /></label>
        <button class="notif-button" type="button" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a5 5 0 0 0-5 5v3.8L5 15v1h14v-1l-2-3.2V8a5 5 0 0 0-5-5zM10 19a2 2 0 0 0 4 0" /></svg><span>3</span></button>
        <button class="profile-chip" type="button">
            <span class="avatar">@(ViewBag.UserLogin != null ? ViewBag.UserLogin.Substring(0, 1).ToUpper() : "?")</span>
            <span class="profile-text"><strong>@ViewBag.UserLogin</strong><small>@ViewBag.UserType</small></span>   
        </button>
    </div>
</header>
