@model System.Data.DataTable
@{ Layout = null; }
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>StockManager - Sorties</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/styles.css" /></head>
<body><div class="app-layout">
@await Html.PartialAsync("_Sidebar")
<div class="main-content">@await Html.PartialAsync("_Topbar", "Sorties")<main class="page-content"><section class="page-shell page-shell-entity">

<div class="page-actions">
  @if(ViewBag.CanEdit==true){<button class="action-button primary" onclick="openModal()"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span>Ajouter une sortie</span></button>}
</div>

<section class="stats-grid">
  <article class="stat-card"><p>Total Sorties</p><strong>@(ViewBag.TotalSorties??0)</strong><small>Mouvements</small></article>
  <article class="stat-card"><p>Quantité totale</p><strong>@(ViewBag.TotalQte??0)</strong><small>Unités</small></article>
</section>

<section class="entity-grid"><div class="entity-left">
<section class="filter-bar">
  <label class="search-input"><svg viewBox="0 0 24 24"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z"/></svg><input type="text" id="searchInput" placeholder="Rechercher une sortie..." oninput="filterTable()" /></label>
  <button class="action-button secondary" onclick="filterTable(true)"><svg viewBox="0 0 24 24"><path d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4"/></svg><span>Réinitialiser</span></button>
</section>
<section class="card"><div class="table-wrapper"><table class="data-table has-actions" id="mainTable">
  <thead><tr><th>ID</th><th>Date</th><th>Qté</th><th>Produit</th><th>Personne</th><th>Stock ID</th><th>Codebarre</th><th>Actions</th></tr></thead>
  <tbody>
    @if(Model!=null){int i=0;foreach(System.Data.DataRow row in Model.Rows){
    string dateStr = row["date_sortie"]==DBNull.Value?"":((DateTime)row["date_sortie"]).ToString("dd/MM/yyyy");
    <tr data-index="@i" class="@(i==0?"selected":"")" onclick="selectRow(this,@i)">
      <td>@row["id"]</td><td>@dateStr</td><td>@row["qte_sortie"]</td>
      <td>@row["produit_label"]</td><td>@row["personne_label"]</td><td>@row["stock_id"]</td><td>@row["codebarre"]</td>
      <td><div class="row-menu-wrap"><button class="row-action" onclick="toggleMenu(event,this)">⋮</button><div class="row-menu">
        @if(ViewBag.CanEdit==true){
        <button onclick="editRow(@i)"><svg viewBox="0 0 24 24"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11z"/></svg>Modifier</button>
        <button class="is-danger" onclick="confirmDelete(@row["id"])"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>Supprimer</button>}
      </div></div></td>
    </tr>
    i++;}}
  </tbody>
</table></div><div class="pagination-row"><p id="paginationInfo"></p></div></section>
</div>
<aside class="detail-panel"><h3>Détails sortie</h3><ul id="detailList"></ul>
  @if(ViewBag.CanEdit==true){<button class="action-button primary full" onclick="editRow(selectedIndex)"><svg viewBox="0 0 24 24"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11z"/></svg><span>Modifier</span></button>}
</aside>
</section>
</section></main></div></div>

<div class="modal-overlay" id="modalOverlay" onclick="closeModalIfBg(event)"><div class="modal-box">
  <div class="modal-header"><h3 id="modalTitle">Ajouter une sortie</h3><button class="modal-close" onclick="closeModal()">✕</button></div>
  <div class="form-row">
    <div class="form-group"><label>Date de sortie</label><input type="date" id="f_date" /></div>
    <div class="form-group"><label>Quantité</label><input type="number" id="f_qte" min="1" /></div>
  </div>
  <div class="form-group"><label>Produit</label>
    <select id="f_pid"><option value="">-- Choisir --</option>
      @if(ViewBag.Produits!=null){foreach(System.Data.DataRow p in ((System.Data.DataTable)ViewBag.Produits).Rows){<option value="@p["produit_id"]">@p["label"]</option>}}
    </select>
  </div>
  <div class="form-row">
    <div class="form-group"><label>Personne</label>
      <select id="f_perid"><option value="">-- Choisir --</option>
        @if(ViewBag.Personnes!=null){foreach(System.Data.DataRow p in ((System.Data.DataTable)ViewBag.Personnes).Rows){<option value="@p["personne_id"]">@p["nom"] @p["prenom"]</option>}}
      </select>
    </div>
    <div class="form-group"><label>ID Stock</label>
      <select id="f_sid"><option value="">-- Choisir --</option>
        @if(ViewBag.Stocks!=null){foreach(System.Data.DataRow s in ((System.Data.DataTable)ViewBag.Stocks).Rows){<option value="@s["id"]">STK-@s["id"]</option>}}
      </select>
    </div>
  </div>
  <div class="form-group"><label>Codebarre</label><input type="text" id="f_code" placeholder="Ex: 3546897512365" /></div>
  <input type="hidden" id="f_id" />
  <div class="modal-footer"><button class="action-button secondary" onclick="closeModal()">Annuler</button><button class="action-button primary" onclick="save()">Enregistrer</button></div>
</div></div>

<div class="modal-overlay" id="confirmOverlay" onclick="closeModalIfBg(event)"><div class="modal-box confirm-dialog">
  <div class="confirm-icon"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></div>
  <h3>Supprimer cette sortie ?</h3><p>Le stock sera restauré en conséquence.</p>
  <div class="modal-footer"><button class="action-button secondary" onclick="closeConfirm()">Annuler</button><button class="action-button primary" style="background:#ef4444" onclick="doDelete()">Supprimer</button></div>
</div></div>
<div class="toast-wrap" id="toastWrap"></div>

<script>
const ROWS=@Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model?.Rows.Cast<System.Data.DataRow>() ?? System.Linq.Enumerable.Empty<System.Data.DataRow>()).Select(r=>new{
  id=r["id"],date=r["date_sortie"]==DBNull.Value?"":(((DateTime)r["date_sortie"]).ToString("yyyy-MM-dd")),
  dateDisp=r["date_sortie"]==DBNull.Value?"":(((DateTime)r["date_sortie"]).ToString("dd/MM/yyyy")),
  qte=r["qte_sortie"],code=r["codebarre"]?.ToString(),pid=r["produit_id"],produit=r["produit_label"]?.ToString(),
  perid=r["personne_id"],personne=r["personne_label"]?.ToString(),sid=r["stock_id"]
}).ToList()));
let selectedIndex=0,deleteId=null;
const FIELDS=[['ID','id'],['Date','dateDisp'],['Quantité','qte'],['Produit','produit'],['Personne','personne'],['Stock ID','sid'],['Codebarre','code']];
function selectRow(el,i){document.querySelectorAll('#mainTable tbody tr').forEach(r=>r.classList.remove('selected'));el.classList.add('selected');selectedIndex=i;updateDetail(ROWS[i]);}
function updateDetail(r){if(!r)return;document.getElementById('detailList').innerHTML=FIELDS.map(([l,k])=>`<li><span>${l}</span><strong>${r[k]||'-'}</strong></li>`).join('');}
function filterTable(reset){if(reset)document.getElementById('searchInput').value='';const q=document.getElementById('searchInput').value.toLowerCase();let n=0;document.querySelectorAll('#mainTable tbody tr').forEach(tr=>{const ok=tr.textContent.toLowerCase().includes(q);tr.style.display=ok?'':'none';if(ok)n++;});document.getElementById('paginationInfo').textContent=`${n} résultat(s)`;}
function toggleMenu(e,btn){e.stopPropagation();const m=btn.nextElementSibling;document.querySelectorAll('.row-menu.is-open').forEach(x=>{if(x!==m)x.classList.remove('is-open');});m.classList.toggle('is-open');}
document.addEventListener('click',()=>document.querySelectorAll('.row-menu.is-open').forEach(m=>m.classList.remove('is-open')));
function openModal(){document.getElementById('modalTitle').textContent='Ajouter une sortie';['f_id','f_qte','f_pid','f_perid','f_sid','f_code'].forEach(id=>document.getElementById(id).value='');document.getElementById('f_date').value=new Date().toISOString().split('T')[0];document.getElementById('modalOverlay').classList.add('is-open');}
function editRow(i){const r=ROWS[i];if(!r)return;document.getElementById('modalTitle').textContent='Modifier la sortie';document.getElementById('f_id').value=r.id;document.getElementById('f_date').value=r.date;document.getElementById('f_qte').value=r.qte;document.getElementById('f_pid').value=r.pid;document.getElementById('f_perid').value=r.perid;document.getElementById('f_sid').value=r.sid;document.getElementById('f_code').value=r.code||'';document.getElementById('modalOverlay').classList.add('is-open');}
function closeModal(){document.getElementById('modalOverlay').classList.remove('is-open');}
function closeConfirm(){document.getElementById('confirmOverlay').classList.remove('is-open');}
function closeModalIfBg(e){if(e.target.classList.contains('modal-overlay')){closeModal();closeConfirm();}}
async function save(){
  const id=document.getElementById('f_id').value,date=document.getElementById('f_date').value,qte=document.getElementById('f_qte').value,pid=document.getElementById('f_pid').value,perid=document.getElementById('f_perid').value,sid=document.getElementById('f_sid').value,code=document.getElementById('f_code').value;
  if(!date||!qte||!pid||!perid||!sid){showToast('Tous les champs obligatoires doivent être remplis.','error');return;}
  const body=new URLSearchParams({dateSortie:date,qteSortie:qte,produitId:pid,personneId:perid,stockId:sid,codebarre:code});if(id)body.append('id',id);
  const r=await fetch(id?'/Sorties/Update':'/Sorties/Create',{method:'POST',body});const d=await r.json();
  if(d.success){showToast(d.message,'success');closeModal();setTimeout(()=>location.reload(),700);}else showToast(d.message,'error');
}
function confirmDelete(id){deleteId=id;document.getElementById('confirmOverlay').classList.add('is-open');}
async function doDelete(){const r=await fetch('/Sorties/Delete',{method:'POST',body:new URLSearchParams({id:deleteId})});const d=await r.json();closeConfirm();if(d.success){showToast(d.message,'success');setTimeout(()=>location.reload(),700);}else showToast(d.message,'error');}
function showToast(msg,type){const t=document.createElement('div');t.className=`toast ${type}`;t.textContent=msg;document.getElementById('toastWrap').appendChild(t);setTimeout(()=>t.remove(),3500);}
if(ROWS.length>0){updateDetail(ROWS[0]);document.getElementById('paginationInfo').textContent=`${ROWS.length} sortie(s)`;}
</script>
</body></html>




