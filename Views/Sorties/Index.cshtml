    <main class="page-content"><section class="page-shell"><div class="page-actions">@if (ViewBag.CanEdit == true) { <button class="action-button primary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg><span>Ajouter une sortie</span></button> }<button class="action-button secondary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M8 11l4 4 4-4M5 20h14" /></svg><span>Exporter</span></button></div><section class="stats-grid"><article class="stat-card"><p>Total sorties</p><strong>438</strong><small>Mouvements</small></article><article class="stat-card"><p>Quantité sortie</p><strong>2 102</strong><small>Unités</small></article><article class="stat-card"><p>Personnes concernées</p><strong>6</strong><small>Actives</small></article><article class="stat-card"><p>Produits sortis</p><strong>74</strong><small>Références</small></article></section><section class="entity-grid"><div class="entity-left"><section class="filter-bar"><label class="search-input"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z" /></svg><input type="text" placeholder="Rechercher une sortie..." /></label><label><span>Date début</span><select><option>01/05/2026</option><option>15/05/2026</option><option>01/04/2026</option></select></label><label><span>Date fin</span><select><option>19/05/2026</option><option>31/05/2026</option><option>30/04/2026</option></select></label><label><span>Produit</span><select><option>Tous</option><option>PRD-001</option><option>PRD-003</option><option>PRD-005</option></select></label><label><span>Personne</span><select><option>Toutes</option><option>Jean Dupont</option><option>Paul Bernard</option><option>Youssef El Amrani</option></select></label><label><span>Stock</span><select><option>Tous</option><option>STK-001</option><option>STK-003</option><option>STK-005</option></select></label><button class="action-button secondary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4" /></svg><span>Réinitialiser</span></button></section><section class="card"><div class="table-wrapper"><table class="data-table"><thead><tr><th>ID</th><th>Date sortie</th><th>Qté sortie</th><th>Code barre</th><th>Produit ID</th><th>Produit</th><th>Personne ID</th><th>Personne</th><th>Stock ID</th><th>Actions</th></tr></thead><tbody><tr data-select-row data-page="sorties" data-index="0" data-row-id="SOR-001" class="selected"><td>SOR-001</td><td>18/05/2026</td><td>8</td><td>3546897512365</td><td>PRD-001</td><td>Chaise de bureau Ergonomique</td><td>PRS-001</td><td>Jean Dupont</td><td>STK-001</td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="sorties" data-index="1" data-row-id="SOR-002" class=""><td>SOR-002</td><td>17/05/2026</td><td>3</td><td>3546897512367</td><td>PRD-003</td><td>Étagère métallique 5 niveaux</td><td>PRS-003</td><td>Paul Bernard</td><td>STK-003</td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="sorties" data-index="2" data-row-id="SOR-003" class=""><td>SOR-003</td><td>16/05/2026</td><td>5</td><td>3546897512369</td><td>PRD-005</td><td>Canapé 3 places tissu</td><td>PRS-005</td><td>Youssef El Amrani</td><td>STK-005</td><td><button class="row-action">⋮</button></td></tr></tbody></table></div>
    <div class="pagination-row">
      <p>Affichage de 1 à 3 sur 438 sorties</p>
      <div class="pagination-controls">
        <button>«</button><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>4</button><button>5</button><span>…</span><button>16</button><button>›</button><button>»</button>
      </div>
    </div>
    </section></div><aside class="detail-panel"><h3>Détails sortie</h3><ul><li><span>ID sortie</span><strong>SOR-001</strong></li><li><span>Date sortie</span><strong>18/05/2026</strong></li><li><span>Quantité sortie</span><strong>8</strong></li><li><span>Code barre</span><strong>3546897512365</strong></li><li><span>Produit</span><strong>Chaise de bureau Ergonomique</strong></li><li><span>Personne</span><strong>Jean Dupont</strong></li><li><span>Stock</span><strong>STK-001</strong></li><li><span>Statut</span><strong>Validée</strong></li><li><span>Note</span><strong>Livraison showroom Casablanca</strong></li></ul><button class="action-button primary full"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5M6 17H4v-6h16v6h-2M7 14h10v7H7z" /></svg><span>Imprimer le bon de sortie</span></button></aside></section></section></main></div></div>
    
  
<script>
  (function() {
    const PAGE_ROWS = [{"id": "SOR-001", "date_sortie": "18/05/2026", "qte_sortie": 8, "codebarre": "3546897512365", "produit_id": "PRD-001", "produit": "Chaise de bureau Ergonomique", "personne_id": "PRS-001", "personne": "Jean Dupont", "stock_id": "STK-001", "statut": "Valid\u00e9e", "note": "Livraison showroom Casablanca"}, {"id": "SOR-002", "date_sortie": "17/05/2026", "qte_sortie": 3, "codebarre": "3546897512367", "produit_id": "PRD-003", "produit": "\u00c9tag\u00e8re m\u00e9tallique 5 niveaux", "personne_id": "PRS-003", "personne": "Paul Bernard", "stock_id": "STK-003", "statut": "Valid\u00e9e", "note": "Transfert d\u00e9p\u00f4t sud"}, {"id": "SOR-003", "date_sortie": "16/05/2026", "qte_sortie": 5, "codebarre": "3546897512369", "produit_id": "PRD-005", "produit": "Canap\u00e9 3 places tissu", "personne_id": "PRS-005", "personne": "Youssef El Amrani", "stock_id": "STK-005", "statut": "Valid\u00e9e", "note": "Commande client B2B"}];
    const DETAIL_FIELDS = [{"label": "ID sortie", "key": "id"}, {"label": "Date sortie", "key": "date_sortie"}, {"label": "Quantit\u00e9 sortie", "key": "qte_sortie"}, {"label": "Code barre", "key": "codebarre"}, {"label": "Produit", "key": "produit"}, {"label": "Personne", "key": "personne"}, {"label": "Stock", "key": "stock_id"}, {"label": "Statut", "key": "statut"}, {"label": "Note", "key": "note"}];

    const rows = document.querySelectorAll("[data-select-row]");
    const detailPanel = document.querySelector(".detail-panel");

    function updateDetail(index) {
      const record = PAGE_ROWS[index];
      if (!record) return;
      
      rows.forEach(r => r.classList.remove("selected"));
      rows[index].classList.add("selected");

      const list = detailPanel.querySelector("ul");
      list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
      
      const descDiv = detailPanel.querySelector(".detail-description p");
      if (descDiv) {
        descDiv.textContent = record.description || record.remarque || "";
      }
    }

    rows.forEach((row, i) => {
      row.addEventListener("click", () => updateDetail(i));
    });
  })();
</script>

  </body>
</html>


