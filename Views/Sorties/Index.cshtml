    </section></div><aside class="detail-panel"><h3>Détails sortie</h3><ul><li><span>ID sortie</span><strong>SOR-001</strong></li><li><span>Date sortie</span><strong>18/05/2026</strong></li><li><span>Quantité sortie</span><strong>8</strong></li><li><span>Code barre</span><strong>3546897512365</strong></li><li><span>Produit</span><strong>Chaise de bureau Ergonomique</strong></li><li><span>Personne</span><strong>Jean Dupont</strong></li><li><span>Stock</span><strong>STK-001</strong></li><li><span>Statut</span><strong>Validée</strong></li><li><span>Note</span><strong>Livraison showroom Casablanca</strong></li></ul><button class="action-button primary full"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5M6 17H4v-6h16v6h-2M7 14h10v7H7z" /></svg><span>Imprimer le bon de sortie</span></button></aside></section></section></main></div></div>
    
  
<script>
  (function() {
    const PAGE_ROWS = [{"id": "SOR-001", "date_sortie": "18/05/2026", "qte_sortie": 8, "codebarre": "3546897512365", "produit_id": "PRD-001", "produit": "Chaise de bureau Ergonomique", "personne_id": "PRS-001", "personne": "Jean Dupont", "stock_id": "STK-001", "statut": "Valid\u00e9e", "note": "Livraison showroom Casablanca"}, {"id": "SOR-002", "date_sortie": "17/05/2026", "qte_sortie": 3, "codebarre": "3546897512367", "produit_id": "PRD-003", "produit": "\u00c9tag\u00e8re m\u00e9tallique 5 niveaux", "personne_id": "PRS-003", "personne": "Paul Bernard", "stock_id": "STK-003", "statut": "Valid\u00e9e", "note": "Transfert d\u00e9p\u00f4t sud"}, {"id": "SOR-003", "date_sortie": "16/05/2026", "qte_sortie": 5, "codebarre": "3546897512369", "produit_id": "PRD-005", "produit": "Canap\u00e9 3 places tissu", "personne_id": "PRS-005", "personne": "Youssef El Amrani", "stock_id": "STK-005", "statut": "Valid\u00e9e", "note": "Commande client B2B"}];
    const DETAIL_FIELDS = [{"label": "ID sortie", "key": "id"}, {"label": "Date sortie", "key": "date_sortie"}, {"label": "Quantit\u00e9 sortie", "key": "qte_sortie"}, {"label": "Code barre", "key": "codebarre"}, {"label": "Produit", "key": "produit"}, {"label": "Personne", "key": "personne"}, {"label": "Stock", "key": "stock_id"}, {"label": "Statut", "key": "statut"}, {"label": "Note", "key": "note"}];

    const rows = document.querySelectorAll("[data-select-row]");
    const detailPanel = document.querySelector(".detail-panel");

    function updateDetail(index) {
      const record = PAGE_ROWS[index];
      if (!record) return;
      
      rows.forEach(r => r.classList.remove("selected"));
      rows[index].classList.add("selected");

      const list = detailPanel.querySelector("ul");
      list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
      
      const descDiv = detailPanel.querySelector(".detail-description p");
      if (descDiv) {
        descDiv.textContent = record.description || record.remarque || "";
      }
    }

    rows.forEach((row, i) => {
      row.addEventListener("click", () => updateDetail(i));
    });
  })();
</script>

