<script>
  (function() {
    const PAGE_ROWS = [{"id": "USR-001", "login": "admin", "mdp": "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022", "type": "Administrateur", "personne_id": "PRS-001", "personne": "Jean Dupont", "dernier_acces": "Aujourd'hui 10:42", "statut": "Actif", "email": "jean.dupont@stockmanager.ma", "tel": "+212 6 01 02 03 04"}, {"id": "USR-002", "login": "operateur1", "mdp": "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022", "type": "Op\u00e9rateur", "personne_id": "PRS-002", "personne": "Claire Martin", "dernier_acces": "Aujourd'hui 09:21", "statut": "Actif", "email": "claire.martin@stockmanager.ma", "tel": "+212 6 11 22 33 44"}, {"id": "USR-003", "login": "magasinier", "mdp": "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022", "type": "Magasinier", "personne_id": "PRS-003", "personne": "Paul Bernard", "dernier_acces": "Hier 17:03", "statut": "Actif", "email": "paul.bernard@stockmanager.ma", "tel": "+212 6 55 44 33 22"}, {"id": "USR-004", "login": "achat", "mdp": "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022", "type": "Op\u00e9rateur", "personne_id": "PRS-004", "personne": "Sophie Lef\u00e8vre", "dernier_acces": "Hier 15:50", "statut": "Inactif", "email": "sophie.lefevre@stockmanager.ma", "tel": "+212 6 74 55 11 82"}, {"id": "USR-005", "login": "vente", "mdp": "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022", "type": "Op\u00e9rateur", "personne_id": "PRS-005", "personne": "Youssef El Amrani", "dernier_acces": "Hier 14:04", "statut": "Actif", "email": "youssef.elamrani@stockmanager.ma", "tel": "+212 6 64 88 11 03"}, {"id": "USR-006", "login": "stock", "mdp": "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022", "type": "Magasinier", "personne_id": "PRS-006", "personne": "Salma Benali", "dernier_acces": "12/05/2026 11:13", "statut": "Actif", "email": "salma.benali@stockmanager.ma", "tel": "+212 6 62 90 17 30"}];
    const DETAIL_FIELDS = [{"label": "ID utilisateur", "key": "id"}, {"label": "Login", "key": "login"}, {"label": "Mot de passe", "key": "mdp"}, {"label": "Type", "key": "type"}, {"label": "Personne ID", "key": "personne_id"}, {"label": "Nom complet", "key": "personne"}, {"label": "Email", "key": "email"}, {"label": "T\u00e9l\u00e9phone", "key": "tel"}, {"label": "Dernier acc\u00e8s", "key": "dernier_acces"}, {"label": "Statut du compte", "key": "statut"}];

    const rows = document.querySelectorAll("[data-select-row]");
    const detailPanel = document.querySelector(".detail-panel");

    function updateDetail(index) {
      const record = PAGE_ROWS[index];
      if (!record) return;
      
      rows.forEach(r => r.classList.remove("selected"));
      rows[index].classList.add("selected");

      const list = detailPanel.querySelector("ul");
      list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
      
      const descDiv = detailPanel.querySelector(".detail-description p");
      if (descDiv) {
        descDiv.textContent = record.description || record.remarque || "";
      }
    }

    rows.forEach((row, i) => {
      row.addEventListener("click", () => updateDetail(i));
    });
  })();
</script>

  </body>
</html>


