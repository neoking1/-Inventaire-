    </section></div><aside class="detail-panel"><h3>Détails produit</h3><ul><li><span>ID Produit</span><strong>PRD-001</strong></li><li><span>Label</span><strong>Chaise de bureau Ergonomique</strong></li><li><span>Catégorie ID</span><strong>CAT-001</strong></li><li><span>Catégorie</span><strong>Mobilier</strong></li><li><span>Stock disponible</span><strong>120</strong></li><li><span>Statut</span><strong>En stock</strong></li><li><span>Origine</span><strong>France</strong></li><li><span>Fournisseur</span><strong>Mobilier Design SARL</strong></li><li><span>Prix unitaire</span><strong>85,00 €</strong></li><li><span>Code barre</span><strong>3546897512365</strong></li><li><span>Date d&#039;ajout</span><strong>12/04/2024</strong></li></ul><div class="detail-description"><h4>Description</h4><p>Chaise ergonomique avec dossier réglable et support lombaire.</p></div>@if (ViewBag.CanEdit == true) { <button class="action-button primary full"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11zM14.8 6.2l3.8 3.8" /></svg><span>Modifier le produit</span></button> }</aside></section></section></main></div></div>
    
  
<script>
  (function() {
    const PAGE_ROWS = [{"produit_id": "PRD-001", "label": "Chaise de bureau Ergonomique", "categorie_id": "CAT-001", "categorie": "Mobilier", "stock": 120, "fournisseur": "Mobilier Design SARL", "origine": "France", "localite": "Entrep\u00f4t Central", "prix": "85,00 \u20ac", "statut": "En stock", "code": "3546897512365", "date": "12/04/2024", "description": "Chaise ergonomique avec dossier r\u00e9glable et support lombaire.", "thumb": "chair"}, {"produit_id": "PRD-002", "label": "Bureau Direction 160x80", "categorie_id": "CAT-002", "categorie": "Tables", "stock": 35, "fournisseur": "Alliances Bois", "origine": "Maroc", "localite": "D\u00e9p\u00f4t Nord", "prix": "250,00 \u20ac", "statut": "Faible", "code": "3546897512366", "date": "10/04/2024", "description": "Bureau en bois massif avec finition noyer.", "thumb": "desk"}, {"produit_id": "PRD-003", "label": "\u00c9tag\u00e8re m\u00e9tallique 5 niveaux", "categorie_id": "CAT-003", "categorie": "Rangement", "stock": 7, "fournisseur": "Office Plus", "origine": "Allemagne", "localite": "D\u00e9p\u00f4t Sud", "prix": "160,00 \u20ac", "statut": "Critique", "code": "3546897512367", "date": "09/04/2024", "description": "\u00c9tag\u00e8re charge lourde, finition anti-corrosion.", "thumb": "shelf"}, {"produit_id": "PRD-004", "label": "Table basse bois massif", "categorie_id": "CAT-002", "categorie": "Tables", "stock": 42, "fournisseur": "Bois & Cr\u00e9ations", "origine": "Italie", "localite": "Showroom Rabat", "prix": "129,00 \u20ac", "statut": "En stock", "code": "3546897512368", "date": "05/04/2024", "description": "Table basse design, plateau ch\u00eane et pieds acier noir.", "thumb": "table"}, {"produit_id": "PRD-005", "label": "Canap\u00e9 3 places tissu", "categorie_id": "CAT-005", "categorie": "Canap\u00e9s", "stock": 18, "fournisseur": "Sud Bureau", "origine": "Maroc", "localite": "Showroom Casablanca", "prix": "540,00 \u20ac", "statut": "Faible", "code": "3546897512369", "date": "03/04/2024", "description": "Canap\u00e9 3 places, tissu premium coloris anthracite.", "thumb": "sofa"}, {"produit_id": "PRD-006", "label": "Armoire 3 portes", "categorie_id": "CAT-003", "categorie": "Rangement", "stock": 26, "fournisseur": "Alliances Bois", "origine": "France", "localite": "Entrep\u00f4t Central", "prix": "310,00 \u20ac", "statut": "En stock", "code": "3546897512370", "date": "01/04/2024", "description": "Armoire 3 portes avec \u00e9tag\u00e8res modulables.", "thumb": "wardrobe"}, {"produit_id": "PRD-007", "label": "Biblioth\u00e8que \u00e9tag\u00e8re", "categorie_id": "CAT-003", "categorie": "Rangement", "stock": 9, "fournisseur": "Office Plus", "origine": "Italie", "localite": "D\u00e9p\u00f4t Nord", "prix": "190,00 \u20ac", "statut": "Critique", "code": "3546897512371", "date": "31/03/2024", "description": "Biblioth\u00e8que 6 niches, structure m\u00e9tal et bois.", "thumb": "bookshelf"}];
    const DETAIL_FIELDS = [{"label": "ID Produit", "key": "produit_id"}, {"label": "Label", "key": "label"}, {"label": "Cat\u00e9gorie ID", "key": "categorie_id"}, {"label": "Cat\u00e9gorie", "key": "categorie"}, {"label": "Stock disponible", "key": "stock"}, {"label": "Statut", "key": "statut"}, {"label": "Origine", "key": "origine"}, {"label": "Fournisseur", "key": "fournisseur"}, {"label": "Prix unitaire", "key": "prix"}, {"label": "Code barre", "key": "code"}, {"label": "Date d'ajout", "key": "date"}];

    const rows = document.querySelectorAll("[data-select-row]");
    const detailPanel = document.querySelector(".detail-panel");

    function updateDetail(index) {
      const record = PAGE_ROWS[index];
      if (!record) return;
      
      rows.forEach(r => r.classList.remove("selected"));
      rows[index].classList.add("selected");

      const list = detailPanel.querySelector("ul");
      list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
      
      const descDiv = detailPanel.querySelector(".detail-description p");
      if (descDiv) {
        descDiv.textContent = record.description || record.remarque || "";
      }
    }

    rows.forEach((row, i) => {
      row.addEventListener("click", () => updateDetail(i));
    });
  })();
</script>

  </body>
</html>


