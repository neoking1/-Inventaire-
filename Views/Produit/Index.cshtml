ion><option>Bois &amp; Créations</option></select></label><label><span>Localité</span><select><option>Toutes</option><option>Entrepôt Central</option><option>Dépôt Nord</option><option>Dépôt Sud</option><option>Showroom Rabat</option><option>Showroom Casablanca</option></select></label><label><span>Statut stock</span><select><option>Tous</option><option>En stock</option><option>Faible</option><option>Critique</option></select></label><button class="action-button secondary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4" /></svg><span>Réinitialiser</span></button></section><section class="card"><div class="table-wrapper"><table class="data-table"><thead><tr><th>ID Produit</th><th>Produit</th><th>Catégorie ID</th><th>Catégorie</th><th>Stock</th><th>Fournisseur</th><th>Origine</th><th>Localité</th><th>Prix</th><th>Statut</th><th>Actions</th></tr></thead><tbody><tr data-select-row data-page="produits" data-index="0" data-row-id="PRD-001" class="selected"><td>PRD-001</td><td><div class="cell-title"><span class="thumb chair"></span><span>Chaise de bureau Ergonomique</span></div></td><td>CAT-001</td><td>Mobilier</td><td>120</td><td>Mobilier Design SARL</td><td>France</td><td>Entrepôt Central</td><td>85,00 €</td><td><span class="status-badge is-success">En stock</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="produits" data-index="1" data-row-id="PRD-002" class=""><td>PRD-002</td><td><div class="cell-title"><span class="thumb desk"></span><span>Bureau Direction 160x80</span></div></td><td>CAT-002</td><td>Tables</td><td>35</td><td>Alliances Bois</td><td>Maroc</td><td>Dépôt Nord</td><td>250,00 €</td><td><span class="status-badge is-warning">Faible</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="produits" data-index="2" data-row-id="PRD-003" class=""><td>PRD-003</td><td><div class="cell-title"><span class="thumb shelf"></span><span>Étagère métallique 5 niveaux</span></div></td><td>CAT-003</td><td>Rangement</td><td>7</td><td>Office Plus</td><td>Allemagne</td><td>Dépôt Sud</td><td>160,00 €</td><td><span class="status-badge is-danger">Critique</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="produits" data-index="3" data-row-id="PRD-004" class=""><td>PRD-004</td><td><div class="cell-title"><span class="thumb table"></span><span>Table basse bois massif</span></div></td><td>CAT-002</td><td>Tables</td><td>42</td><td>Bois &amp; Créations</td><td>Italie</td><td>Showroom Rabat</td><td>129,00 €</td><td><span class="status-badge is-success">En stock</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="produits" data-index="4" data-row-id="PRD-005" class=""><td>PRD-005</td><td><div class="cell-title"><span class="thumb sofa"></span><span>Canapé 3 places tissu</span></div></td><td>CAT-005</td><td>Canapés</td><td>18</td><td>Sud Bureau</td><td>Maroc</td><td>Showroom Casablanca</td><td>540,00 €</td><td><span class="status-badge is-warning">Faible</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="produits" data-index="5" data-row-id="PRD-006" class=""><td>PRD-006</td><td><div class="cell-title"><span class="thumb wardrobe"></span><span>Armoire 3 portes</span></div></td><td>CAT-003</td><td>Rangement</td><td>26</td><td>Alliances Bois</td><td>France</td><td>Entrepôt Central</td><td>310,00 €</td><td><span class="status-badge is-success">En stock</span></td><td><button class="row-action">⋮</button></td></tr><tr data-select-row data-page="produits" data-index="6" data-row-id="PRD-007" class=""><td>PRD-007</td><td><div class="cell-title"><span class="thumb bookshelf"></span><span>Bibliothèque étagère</span></div></td><td>CAT-003</td><td>Rangement</td><td>9</td><td>Office Plus</td><td>Italie</td><td>Dépôt Nord</td><td>190,00 €</td><td><span class="status-badge is-danger">Critique</span></td><td><button class="row-action">⋮</button></td></tr></tbody></table></div>
    <div class="pagination-row">
      <p>Affichage de 1 à 10 sur 156 produits</p>
      <div class="pagination-controls">
        <button>«</button><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>4</button><button>5</button><span>…</span><button>16</button><button>›</button><button>»</button>
      </div>
