@model System.Data.DataTable
@{ Layout = null; }
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>StockManager - Produits</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/styles.css" /></head>
<body><div class="app-layout">
@await Html.PartialAsync("_Sidebar")
<div class="main-content">@await Html.PartialAsync("_Topbar", "Produits")<main class="page-content"><section class="page-shell page-shell-produit">

<div class="page-actions">
  @if(ViewBag.CanEdit==true){<button class="action-button primary" onclick="openModal()"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span>Ajouter un produit</span></button>}
</div>

<section class="stats-grid">
  <article class="stat-card"><p>Total Produits</p><strong>@(ViewBag.TotalProduits??0)</strong><small>Références</small></article>
  <article class="stat-card"><p>Catégories</p><strong>@(ViewBag.TotalCategories??0)</strong><small>Catégories</small></article>
</section>

<section class="entity-grid produit-grid"><div class="entity-left">
<section class="filter-bar">
  <label class="search-input"><svg viewBox="0 0 24 24"><path d="M11 4a7 7 0 1 0 4.9 12l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z"/></svg><input type="text" id="searchInput" placeholder="Rechercher un produit..." oninput="filterTable()" /></label>
  <label><span>Catégorie</span>
    <select id="filterCat" onchange="filterTable()">
      <option value="">Toutes</option>
      @if(ViewBag.Categories!=null){foreach(System.Data.DataRow c in ((System.Data.DataTable)ViewBag.Categories).Rows){
        <option value="@c["nom_categorie"]">@c["nom_categorie"]</option>
      }}
    </select>
  </label>
  <button class="action-button secondary" onclick="resetFilters()"><svg viewBox="0 0 24 24"><path d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 0 0-14-4M4 14a8 8 0 0 0 14 4"/></svg><span>Réinitialiser</span></button>
</section>
<section class="card"><div class="table-wrapper"><table class="data-table has-actions" id="mainTable">
  <thead><tr><th>ID</th><th>Label</th><th>Catégorie</th><th>Actions</th></tr></thead>
  <tbody>
    @if(Model!=null){int i=0;foreach(System.Data.DataRow row in Model.Rows){
    <tr data-index="@i" class="@(i==0?"selected":"")" onclick="selectRow(this,@i)">
      <td>@row["produit_id"]</td><td>@row["label"]</td><td>@row["nom_categorie"]</td>
      <td><div class="row-menu-wrap"><button class="row-action" onclick="toggleMenu(event,this)">⋮</button><div class="row-menu">
        @if(ViewBag.CanEdit==true){
        <button onclick="editRow(@i)"><svg viewBox="0 0 24 24"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11z"/></svg>Modifier</button>
        <button class="is-danger" onclick="confirmDelete(@row["produit_id"])"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>Supprimer</button>}
      </div></div></td>
    </tr>
    i++;}}
  </tbody>
</table></div><div class="pagination-row"><p id="paginationInfo"></p></div></section>
</div>
<aside class="detail-panel"><h3>Détails produit</h3><ul id="detailList"></ul>
  @if(ViewBag.CanEdit==true){<button class="action-button primary full" onclick="editRow(selectedIndex)"><svg viewBox="0 0 24 24"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11z"/></svg><span>Modifier</span></button>}
</aside>
</section>
</section></main></div></div>

<div class="modal-overlay" id="modalOverlay" onclick="closeModalIfBg(event)"><div class="modal-box">
  <div class="modal-header"><h3 id="modalTitle">Ajouter un produit</h3><button class="modal-close" onclick="closeModal()">✕</button></div>
  <div class="form-group"><label>Label / Désignation</label><input type="text" id="f_label" placeholder="Ex: Chaise ergonomique" /></div>
  <div class="form-group"><label>Catégorie</label>
    <select id="f_cat">
      <option value="">-- Choisir --</option>
      @if(ViewBag.Categories!=null){foreach(System.Data.DataRow c in ((System.Data.DataTable)ViewBag.Categories).Rows){
        <option value="@c["id"]">@c["nom_categorie"]</option>
      }}
    </select>
  </div>
  <input type="hidden" id="f_id" />
  <div class="modal-footer"><button class="action-button secondary" onclick="closeModal()">Annuler</button><button class="action-button primary" onclick="save()">Enregistrer</button></div>
</div></div>

<div class="modal-overlay" id="confirmOverlay" onclick="closeModalIfBg(event)"><div class="modal-box confirm-dialog">
  <div class="confirm-icon"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></div>
  <h3>Supprimer ce produit ?</h3><p>Cette action est irréversible.</p>
  <div class="modal-footer"><button class="action-button secondary" onclick="closeConfirm()">Annuler</button><button class="action-button primary" style="background:#ef4444" onclick="doDelete()">Supprimer</button></div>
</div></div>
<div class="toast-wrap" id="toastWrap"></div>

<script>
const ROWS=@Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model?.Rows.Cast<System.Data.DataRow>() ?? System.Linq.Enumerable.Empty<System.Data.DataRow>()).Select(r=>new{
  id=r["produit_id"],label=r["label"]?.ToString(),catId=r["categorie_id"],cat=r["nom_categorie"]?.ToString()
}).ToList()));
let selectedIndex=0,deleteId=null;
function selectRow(el,i){document.querySelectorAll('#mainTable tbody tr').forEach(r=>r.classList.remove('selected'));el.classList.add('selected');selectedIndex=i;updateDetail(ROWS[i]);}
function updateDetail(r){if(!r)return;document.getElementById('detailList').innerHTML=`<li><span>ID</span><strong>${r.id}</strong></li><li><span>Label</span><strong>${r.label||'-'}</strong></li><li><span>Catégorie</span><strong>${r.cat||'-'}</strong></li>`;}
function filterTable(){const q=document.getElementById('searchInput').value.toLowerCase(),cat=document.getElementById('filterCat').value.toLowerCase();let n=0;document.querySelectorAll('#mainTable tbody tr').forEach(tr=>{const ok=tr.textContent.toLowerCase().includes(q)&&(!cat||tr.cells[2]?.textContent.toLowerCase()===cat);tr.style.display=ok?'':'none';if(ok)n++;});document.getElementById('paginationInfo').textContent=`${n} résultat(s)`;}
function resetFilters(){document.getElementById('searchInput').value='';document.getElementById('filterCat').value='';filterTable();}
function toggleMenu(e,btn){e.stopPropagation();const m=btn.nextElementSibling;document.querySelectorAll('.row-menu.is-open').forEach(x=>{if(x!==m)x.classList.remove('is-open');});m.classList.toggle('is-open');}
document.addEventListener('click',()=>document.querySelectorAll('.row-menu.is-open').forEach(m=>m.classList.remove('is-open')));
function openModal(){document.getElementById('modalTitle').textContent='Ajouter un produit';document.getElementById('f_id').value='';document.getElementById('f_label').value='';document.getElementById('f_cat').value='';document.getElementById('modalOverlay').classList.add('is-open');}
function editRow(i){const r=ROWS[i];if(!r)return;document.getElementById('modalTitle').textContent='Modifier le produit';document.getElementById('f_id').value=r.id;document.getElementById('f_label').value=r.label||'';document.getElementById('f_cat').value=r.catId||'';document.getElementById('modalOverlay').classList.add('is-open');}
function closeModal(){document.getElementById('modalOverlay').classList.remove('is-open');}
function closeConfirm(){document.getElementById('confirmOverlay').classList.remove('is-open');}
function closeModalIfBg(e){if(e.target.classList.contains('modal-overlay')){closeModal();closeConfirm();}}
async function save(){
  const id=document.getElementById('f_id').value,label=document.getElementById('f_label').value.trim(),catId=document.getElementById('f_cat').value;
  if(!label){showToast('Le label est requis.','error');return;}
  if(!catId){showToast('Sélectionnez une catégorie.','error');return;}
  const body=new URLSearchParams({label,categorieId:catId});if(id)body.append('id',id);
  const r=await fetch(id?'/Produit/Update':'/Produit/Create',{method:'POST',body});const d=await r.json();
  if(d.success){showToast(d.message,'success');closeModal();setTimeout(()=>location.reload(),700);}else showToast(d.message,'error');
}
function confirmDelete(id){deleteId=id;document.getElementById('confirmOverlay').classList.add('is-open');}
async function doDelete(){const r=await fetch('/Produit/Delete',{method:'POST',body:new URLSearchParams({id:deleteId})});const d=await r.json();closeConfirm();if(d.success){showToast(d.message,'success');setTimeout(()=>location.reload(),700);}else showToast(d.message,'error');}
function showToast(msg,type){const t=document.createElement('div');t.className=`toast ${type}`;t.textContent=msg;document.getElementById('toastWrap').appendChild(t);setTimeout(()=>t.remove(),3500);}
if(ROWS.length>0){updateDetail(ROWS[0]);document.getElementById('paginationInfo').textContent=`${ROWS.length} produit(s)`;}
</script>
</body></html>



