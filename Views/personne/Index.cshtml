    </section></div><aside class="detail-panel"><h3>Détails personne</h3><ul><li><span>ID Personne</span><strong>PRS-001</strong></li><li><span>Nom</span><strong>Dupont</strong></li><li><span>Prénom</span><strong>Jean</strong></li><li><span>Téléphone</span><strong>+212 6 01 02 03 04</strong></li><li><span>CIN</span><strong>AB12345</strong></li><li><span>Localité ID</span><strong>LOC-001</strong></li><li><span>Localité</span><strong>Entrepôt Central</strong></li><li><span>Utilisateur lié</span><strong>admin</strong></li><li><span>Statut contact</span><strong>Vérifié</strong></li><li><span>Date d&#039;ajout</span><strong>03/01/2026</strong></li><li><span>Dernière mise à jour</span><strong>18/05/2026</strong></li></ul><button class="action-button primary full"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11zM14.8 6.2l3.8 3.8" /></svg><span>Modifier la personne</span></button></aside></section></section></main></div></div>
    
  
<script>
  (function() {
    const PAGE_ROWS = [{"personne_id": "PRS-001", "nom": "Dupont", "prenom": "Jean", "n_tel": "+212 6 01 02 03 04", "cin": "AB12345", "localite_id": "LOC-001", "localite": "Entrep\u00f4t Central", "contact": "V\u00e9rifi\u00e9", "user": "admin", "date_ajout": "03/01/2026", "maj": "18/05/2026"}, {"personne_id": "PRS-002", "nom": "Martin", "prenom": "Claire", "n_tel": "+212 6 11 22 33 44", "cin": "CD98765", "localite_id": "LOC-004", "localite": "Showroom Rabat", "contact": "V\u00e9rifi\u00e9", "user": "operateur1", "date_ajout": "11/01/2026", "maj": "17/05/2026"}, {"personne_id": "PRS-003", "nom": "Bernard", "prenom": "Paul", "n_tel": "+212 6 55 44 33 22", "cin": "EF45678", "localite_id": "LOC-003", "localite": "D\u00e9p\u00f4t Sud", "contact": "V\u00e9rifi\u00e9", "user": "magasinier", "date_ajout": "14/01/2026", "maj": "17/05/2026"}, {"personne_id": "PRS-004", "nom": "Lef\u00e8vre", "prenom": "Sophie", "n_tel": "+212 6 74 55 11 82", "cin": "GH76124", "localite_id": "LOC-002", "localite": "D\u00e9p\u00f4t Nord", "contact": "Non v\u00e9rifi\u00e9", "user": "achat", "date_ajout": "20/01/2026", "maj": "15/05/2026"}, {"personne_id": "PRS-005", "nom": "El Amrani", "prenom": "Youssef", "n_tel": "+212 6 64 88 11 03", "cin": "IJ44019", "localite_id": "LOC-005", "localite": "Showroom Casablanca", "contact": "V\u00e9rifi\u00e9", "user": "vente", "date_ajout": "02/02/2026", "maj": "18/05/2026"}, {"personne_id": "PRS-006", "nom": "Benali", "prenom": "Salma", "n_tel": "+212 6 62 90 17 30", "cin": "KL22008", "localite_id": "LOC-001", "localite": "Entrep\u00f4t Central", "contact": "V\u00e9rifi\u00e9", "user": "stock", "date_ajout": "10/02/2026", "maj": "16/05/2026"}];
    const DETAIL_FIELDS = [{"label": "ID Personne", "key": "personne_id"}, {"label": "Nom", "key": "nom"}, {"label": "Pr\u00e9nom", "key": "prenom"}, {"label": "T\u00e9l\u00e9phone", "key": "n_tel"}, {"label": "CIN", "key": "cin"}, {"label": "Localit\u00e9 ID", "key": "localite_id"}, {"label": "Localit\u00e9", "key": "localite"}, {"label": "Utilisateur li\u00e9", "key": "user"}, {"label": "Statut contact", "key": "contact"}, {"label": "Date d'ajout", "key": "date_ajout"}, {"label": "Derni\u00e8re mise \u00e0 jour", "key": "maj"}];

    const rows = document.querySelectorAll("[data-select-row]");
    const detailPanel = document.querySelector(".detail-panel");

    function updateDetail(index) {
      const record = PAGE_ROWS[index];
      if (!record) return;
      
      rows.forEach(r => r.classList.remove("selected"));
      rows[index].classList.add("selected");

      const list = detailPanel.querySelector("ul");
      list.innerHTML = DETAIL_FIELDS.map(f => `<li><span>${f.label}</span><strong>${record[f.key] || "-"}</strong></li>`).join("");
      
      const descDiv = detailPanel.querySelector(".detail-description p");
      if (descDiv) {
        descDiv.textContent = record.description || record.remarque || "";
      }
    }

    rows.forEach((row, i) => {
      row.addEventListener("click", () => updateDetail(i));
    });
  })();
</script>

  </body>
</html>


